# Used at `next build` time (NEXT_PUBLIC_* is inlined into the client bundle).
# Local `npm run dev` can omit this file; the app falls back to http://127.0.0.1:8000

# Do not put passwords or session secrets in NEXT_PUBLIC_* variables.

# Local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Render example (set this in the frontend service Build environment):
# NEXT_PUBLIC_API_URL=https://hap-api.onrender.com
