# Copy to backend/.env for local overrides (optional). Not loaded automatically.
# Local uvicorn works without this file (auth off unless HAP_AUTH_ENABLED=true).

# Persistent disk on Render, e.g. /var/data
# HAP_STORAGE_DIR=/var/data

# Comma-separated frontend origins. Never use * with login cookies.
# HAP_CORS_ORIGINS=https://hap-web.onrender.com,http://localhost:3000

# --- Auth (required on Render / HAP_ENV=production) ---
# Local: leave unset or HAP_AUTH_ENABLED=false (default) to keep current open localhost.
# Production always requires auth even if HAP_AUTH_ENABLED=false.
# HAP_AUTH_ENABLED=true
# HAP_AUTH_USERNAME=you@example.com
# HAP_AUTH_PASSWORD_HASH=$2b$12$replace_with_output_of_python_-m_hap_auth
# HAP_SESSION_SECRET=replace_with_output_of_generate-session-secret
# HAP_SESSION_TTL_SECONDS=43200
# HAP_COOKIE_SECURE=true
# HAP_COOKIE_SAMESITE=none
#
# Separate *.onrender.com hosts are cross-site: use SameSite=none and Secure=true.
# Safer: put UI and API on one parent domain (app.example.com + api.example.com)
# then SameSite=lax is enough.

# --- Google Drive (daily batch downloads its input files instead of reading them from the HAP work folder) ---
# One-time: save a Desktop-app OAuth client JSON as backend/storage/drive/client_secret.json, then run  python scripts/drive_login.py
# HAP_DRIVE_FOLDER_ID=<folder id or https://drive.google.com/drive/folders/... link>
# HAP_DRIVE_CLIENT_SECRET=C:\path\to\client_secret.json   # optional override
# HAP_DRIVE_AUTH_DIR=C:\path\to\folder                    # optional: where token.json is kept

# --- HAP Analyst agent (Claude) ---
# The chat endpoint POST /analysis/{id}/chat is read-only and needs an API key.
# Analysis artifacts (filing data, model results) are sent to the Anthropic API when you chat.
# ANTHROPIC_API_KEY=sk-ant-...
# HAP_AGENT_MODEL=claude-sonnet-5-5   # routine chat (cheaper)
# HAP_STRONG_MODEL=claude-opus-5-5     # reserved for the agent's own view
# HAP_MONTHLY_BUDGET_USD=20            # hard monthly cap on Claude spend
# HAP_AGENT_EFFORT=medium            # low | medium | high | xhigh | max
# HAP_AGENT_FALLBACKS=1              # 0 disables server-side refusal fallback
# HAP_AGENT_MAX_ITERATIONS=10

# --- Hardening ---
# HAP_MAX_UPLOAD_MB=200              # per-file upload cap
# SEC requires a real contact address in the User-Agent:
# HAP_SEC_USER_AGENT=HAP-Platform you@yourfirm.com

# --- Email delivery (each finished analysis is emailed with the workbook attached) ---
# Create an APP PASSWORD for the sending mailbox (Google account > Security > 2-Step Verification > App passwords) and put it in backend/.env (never commit .env)
# HAP_EMAIL_TO=houda@vlixes.us
# HAP_SMTP_USER=sender@example.com
# HAP_SMTP_PASSWORD=app-password-here
# HAP_SMTP_HOST=smtp.gmail.com
# HAP_SMTP_PORT=587
