# Copy to backend/.env for local overrides (optional). Not loaded automatically.
# Local uvicorn works without this file (auth off unless HAP_AUTH_ENABLED=true).

# Persistent disk on Render, e.g. /var/data
# HAP_STORAGE_DIR=/var/data

# Comma-separated frontend origins. Never use * with login cookies.
# HAP_CORS_ORIGINS=https://hap-web.onrender.com,http://localhost:3000

# --- Auth (required on Render / HAP_ENV=production) ---
# Local: leave unset or HAP_AUTH_ENABLED=false (default) to keep current open localhost.
# Production always requires auth even if HAP_AUTH_ENABLED=false.
# HAP_AUTH_ENABLED=true
# HAP_AUTH_USERNAME=you@example.com
# HAP_AUTH_PASSWORD_HASH=$2b$12$replace_with_output_of_python_-m_hap_auth
# HAP_SESSION_SECRET=replace_with_output_of_generate-session-secret
# HAP_SESSION_TTL_SECONDS=43200
# HAP_COOKIE_SECURE=true
# HAP_COOKIE_SAMESITE=none
#
# Separate *.onrender.com hosts are cross-site: use SameSite=none and Secure=true.
# Safer: put UI and API on one parent domain (app.example.com + api.example.com)
# then SameSite=lax is enough.
